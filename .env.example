# ============================================
# BlackSentinel Vault - Environment Configuration
# ============================================

# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/blacksentinel_vault
DATABASE_SSL=false
DATABASE_POOL_SIZE=20

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Encryption
MASTER_KEY=
WRAPPING_KEY=
HSM_ENABLED=false
HSM_PROVIDER=
HSM_PIN=

# Authentication
JWT_SECRET=
JWT_EXPIRATION=3600
REFRESH_TOKEN_EXPIRATION=604800
MFA_ISSUER=BlackSentinel Vault
TOTP_SECRET=

# OAuth / SSO
SSO_ENABLED=false
SSO_PROVIDER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=

# LDAP / Active Directory
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=

# Kubernetes
K8S_ENABLED=false
K8S_CONFIG_PATH=
K8S_NAMESPACE=

# AWS
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT=

# Azure
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# Google Cloud
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_KEY=

# AI/ML Engine
AI_ENGINE_ENABLED=true
AI_MODEL_PATH=
AI_INFERENCE_URL=

# Audit
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=/var/log/blacksentinel/audit
AUDIT_RETENTION_DAYS=365

# Session Recording
SESSION_RECORDING_ENABLED=true
SESSION_RECORDING_PATH=/var/log/blacksentinel/sessions

# TLS
TLS_CERT_PATH=
TLS_KEY_PATH=
TLS_CA_PATH=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Encryption at Rest
ENCRYPTION_AT_REST_ENABLED=true
ENCRYPTION_ALGORITHM=AES-256-GCM
