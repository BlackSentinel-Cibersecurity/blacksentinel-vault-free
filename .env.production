# ============================================
# BlackSentinel Vault - Production Configuration
# ============================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=warn

# Database (PostgreSQL)
DATABASE_URL=postgresql://blacksentinel:STRONG_PASSWORD_HERE@localhost:5432/blacksentinel_vault
DATABASE_SSL=true
DATABASE_POOL_SIZE=50

# Redis
REDIS_URL=redis://:STRONG_REDIS_PASSWORD_HERE@localhost:6379

# Encryption Keys (GENERATE NEW KEYS FOR PRODUCTION!)
MASTER_KEY=GENERATE_WITH_openssl_rand_hex_32
JWT_SECRET=GENERATE_WITH_openssl_rand_hex_64
JWT_EXPIRATION=3600
REFRESH_TOKEN_EXPIRATION=604800

# MFA
MFA_ISSUER=BlackSentinel Vault

# CORS (update with your domain)
CORS_ORIGINS=https://vault.yourcompany.com,https://admin.yourcompany.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Features
AUDIT_LOG_ENABLED=true
SESSION_RECORDING_ENABLED=true
AI_ENGINE_ENABLED=true
ENCRYPTION_AT_REST_ENABLED=true
ENCRYPTION_ALGORITHM=AES-256-GCM

# SSL/TLS (if terminating at app level)
# TLS_CERT_PATH=/etc/ssl/certs/vault.crt
# TLS_KEY_PATH=/etc/ssl/private/vault.key
